{
  // Cloudflare Workers: file tĩnh trong web/ + một Worker nhỏ (worker.js) cho vài đường /api/*.
  // Chỉ thư mục web được đưa lên mạng; .sql, hướng dẫn, nhật ký nằm ngoài nên không bao giờ lộ.
  // Khoá quản trị Supabase là SECRET đặt trong Cloudflare (Settings → Variables and Secrets), không ghi ở đây.
  // keep_vars: mỗi lần GitHub tự phát lại KHÔNG được xoá biến/secret đã đặt tay trong Cloudflare.
  "name": "lop-hoc-online",
  "main": "./worker.js",
  "compatibility_date": "2025-06-01",
  // giữ địa chỉ lop-hoc-online.giangduonghoahoc.workers.dev: lần phát nào cũng bật lại đường này
  "workers_dev": true,
  "keep_vars": true,
  // sao lưu tự động (v28): 20:00 UTC thứ Bảy = 3:00 sáng Chủ nhật giờ Việt Nam → worker.js scheduled()
  "triggers": { "crons": ["0 20 * * 6"] },
  // tên miền riêng (gắn 11/9/2026): Worker nhận cả tên này lẫn mọi tên con; workers.dev vẫn chạy song song
  "vars": { "TEN_MIEN": "giangduonghoahoc.com" },
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    // mặc định Cloudflare trả tệp tĩnh TRƯỚC khi chạy worker.js → đường "/" cho app (UA LopHocApp) không bao giờ tới Worker.
    // Bật để mọi yêu cầu qua Worker; Worker vẫn gọi env.ASSETS.fetch nên _headers và chuyển hướng .html giữ nguyên.
    // chỉ ba đường cần Worker: gốc (app cũ mở / → trang học), index.html, và /api/*. Tệp tĩnh còn lại Cloudflare trả thẳng,
    // không tính vào hạn mức yêu cầu Worker (gói free 100.000/ngày) — đỡ bị vét quota khi có kẻ spam.
    "run_worker_first": ["/", "/index.html", "/api/*"]
  }
}
